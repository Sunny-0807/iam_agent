# ─────────────────────────────────────────────────────────────────────────────
# .dockerignore — files excluded from Docker build context
# ─────────────────────────────────────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
.venv/
env/
.env.bak

# Secrets — NEVER bake into image
.env

# Audit log — mounted as volume
audit.jsonl

# Watched folders — mounted as volumes
watched_inbox/
watched_processing/
watched_processed/
watched_failed/
watched_apps_inbox/
watched_apps_processing/
watched_apps_processed/
watched_apps_failed/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
test_*.csv

# Git
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker files themselves (no need to copy into image)
Dockerfile
docker-compose.yml
.dockerignore

# Docs
*.md

